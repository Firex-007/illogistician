PORT=3000
NODE_ENV=development

# HMAC shared secret (must match ESP32 firmware)
HMAC_KEY=your_hmac_secret_key_here
ALLOWED_DEVICE_ID=cargo-esp32-001

# Pinata IPFS (optional — system works without it)
PINATA_JWT=your_pinata_jwt_here
PINATA_API_KEY=your_pinata_api_key
PINATA_API_secret=your_pinata_api_secret

# Blockchain (optional — set to false to disable)
ENABLE_BLOCKCHAIN_ANCHOR=false
CHAIN_ID=31337
AMOY_RPC_URL=http://127.0.0.1:8545
WALLET_PRIVATE_KEY=your_wallet_private_key
CONTRACT_ADDRESS=your_contract_address
